# Robinhood execution track — copy to .env.robinhood.paper or .env.robinhood.live
# NEVER commit real credentials. Never mix paper and live in one file.

# Mode
ROBINHOOD_ENV=paper
EXECUTION_LIVE=0

# Filled in when Tony's Robinhood agent / API access is ready:
# ROBINHOOD_API_KEY=
# ROBINHOOD_API_SECRET=
# ROBINHOOD_ACCOUNT_ID=
# ROBINHOOD_MCP_URL=

# Safety
TRADING_PAUSED=0
ALLOCATION_MODE=single_top1
