# =============================================================================
# AI Investment Agent — Environment Variables
# Copy to .env and fill in your keys. NEVER commit .env to git.
# See docs/FEES_AT_A_GLANCE.md for cost details.
# =============================================================================

# --- REQUIRED (Phase 0 / Gate 0) ---

# Alpaca paper trading (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Paper endpoint (do not change unless Alpaca docs say otherwise)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic Claude API (https://console.anthropic.com)
# Check Settings → Billing for your free credit balance before testing.
ANTHROPIC_API_KEY=

# FRED / St. Louis Fed (https://fredaccount.stlouisfed.org/useraccount/apikey)
FRED_API_KEY=

# Finnhub (https://finnhub.io/dashboard) — personal use only on free tier
FINNHUB_API_KEY=

# --- OPTIONAL ---

# Massive / Polygon (https://massive.com/dashboard) — historical backfill only
MASSIVE_API_KEY=

# FastAPI dashboard auth (generate a random string)
APP_API_KEY=change-me-to-a-random-secret

# Test ticker used by verify_access.py
VERIFY_TEST_TICKER=SPY
